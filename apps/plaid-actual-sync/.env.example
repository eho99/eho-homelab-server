# ---- Plaid ---------------------------------------------------------------
# Dashboard -> API keys. Sandbox uses https://sandbox.plaid.com, production
# uses https://production.plaid.com. Do not mix these up: credentials are not
# interchangeable between environments.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Optional. Only needed if you use Plaid's hosted Link flow instead of running
# link.html yourself.
# PLAID_WEBHOOK_URL=

# ---- Actual Budget (OPTIONAL) -------------------------------------------
# Leave ALL THREE of these unset to run in "Plaid-only" mode: you can connect
# bank accounts and preview raw transactions from the dashboard, but nothing is
# ever synced into a budget. Set all three to enable syncing.
#
# Setting only some is a startup error rather than a silent partial config.
#
# ACTUAL_URL: URL of the Actual server as seen FROM this container. Over
# compose that is the container name and its internal port, NOT the Caddy HTTPS
# port:
#   http://actual-server:5006
# Using the compose-internal URL keeps this on plain HTTP and avoids the
# self-signed-cert problem entirely. If you must use https://, mount the CA
# and set NODE_EXTRA_CA_CERTS=/certs/server.crt (see README).
#ACTUAL_URL=http://actual-server:5006
# The server login password (Settings -> General -> "Set password").
#ACTUAL_PASSWORD=
# Budget Sync ID: Actual -> Settings -> Show advanced settings -> Sync ID.
# This is a UUID that looks like 1cfdbb80-6274-49bf-b0c2-737235a4c81f
#ACTUAL_BUDGET_ID=
# Only set if you enabled end-to-end encryption on the budget.
#ACTUAL_EE_PASSWORD=

# ---- Webhooks (OPTIONAL) -----------------------------------------------
# Public HTTPS URL Plaid can POST to. Leave unset for poll-only operation,
# which is fully supported — webhooks only make syncs happen sooner.
#
# IMPORTANT: the scheduled sync stays the backbone either way. A missed webhook
# costs latency, never data, because the next timed run pulls from the cursor
# regardless.
#
# Set this on the machine that runs the stack, not a specific tunnel — it is
# just an env var so the deployment can move without code changes.
#
# Must be reachable from the PUBLIC internet. A private Tailscale address
# (100.x) is NOT reachable by Plaid. If you need Tailscale, that means
# `tailscale funnel`, not `tailscale serve`.
#
# Plaid requires HTTPS; the scheme is validated at startup.
#
# A bare origin is accepted and /webhook is appended automatically.
#PLAID_WEBHOOK_URL=https://your-host.example/webhook
#
# Minimum seconds between webhook-triggered syncs. Plaid can fire a burst of
# webhooks on a busy banking day; this collapses them into one sync.
WEBHOOK_DEBOUNCE_SECONDS=300

# ---- Behaviour -----------------------------------------------------------
# How often to run a sync, in minutes.
SYNC_INTERVAL_MINUTES=360
# How far back to look on the very first sync of a given Plaid item, in days.
# Plaid caps this per item type; 180 is safe for most.
INITIAL_SYNC_DAYS=90
# Rolling window for /investments/* (Schwab, Fidelity). Plaid has NO cursor
# for investments, so every cycle re-reads this range and dedupes via
# imported_id. 30 days is plenty for dividends and interest.
INVESTMENT_WINDOW_DAYS=30
# Set to "false" to start the worker but skip syncing entirely (useful for
# verifying credentials and connectivity first).
ENABLED=true

# When Plaid reports a transaction as removed (a pending charge dropped, or a
# posted one reversed), delete the matching row from Actual. Set to "false" to
# only log a warning instead.
#
# WARNING: this deletes budget data. If you have categorised or annotated one
# of these transactions in Actual, that work is lost. Only the ghost rows are
# affected — every other transaction is untouched.
DELETE_REMOVED_TRANSACTIONS=true

# ---- Re-authentication page ---------------------------------------------
# The worker serves a small web page for re-linking institutions whose OAuth
# grant has expired. It can initiate a bank login, so it MUST be protected.
# Leave these unset and the page runs completely unprotected (it logs a
# warning at startup, but it will still be reachable).
WEB_USERNAME=
WEB_PASSWORD=
# Port the page listens on inside the container.
WEB_PORT=8090
# Separate port for the webhook receiver, deliberately isolated so that
# exposing it publicly does not also expose the dashboard.
WEBHOOK_PORT=8091
# The URL this service is reached at FROM A BROWSER. Plaid requires the
# redirect URI to match a registered value EXACTLY, so this must equal what
# you registered on the Plaid dashboard — scheme, host, port and /callback.
#
#   <PUBLIC_URL>/callback   is the redirect URI you register.
#
# IMPORTANT — two different rules:
#   * Sandbox only: http://localhost:9444 is accepted over plain HTTP.
#   * Production: the URI MUST be HTTPS and must resolve from the browser.
#     "localhost" will not work for production re-auth, because the browser
#     requesting it is not necessarily the machine running this container.
#     Use a real hostname that resolves on your network, e.g.
#     https://homelab.example.internal:9444
PUBLIC_URL=https://localhost:9444